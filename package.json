{
  "name": "ashadi-jewellers-labour-system",
  "version": "1.0.0",
  "description": "Labour Cost & Production Management System for Ashadi Jewellers",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client && node -e \"const fs=require('fs'); if(fs.existsSync('client/dist')){fs.cpSync('client/dist','dist',{recursive:true})}\"",
    "install:all": "npm install",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run dev --workspace=server",
    "start:frontend": "npm run dev --workspace=client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.1",
    "mongoose": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
