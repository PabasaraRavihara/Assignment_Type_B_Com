{
  "name": "ashadi-jewellers-labour-system",
  "version": "1.0.0",
  "description": "Labour Cost & Production Management System for Ashadi Jewellers",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run dev --workspace=server",
    "start:frontend": "npm run dev --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
